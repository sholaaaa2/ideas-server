:root {
    --bg: #f6f7fb;
    --surface: #ffffff;
    --surface-soft: #f2f3f8;
    --text: #191b24;
    --text-soft: #747789;
    --primary: #575fcf;
    --primary-hover: #464dbb;
    --primary-soft: #eef0ff;
    --border: #e7e8ef;
    --danger: #db3c4c;
    --danger-soft: #fff0f1;
    --radius: 18px;
    --header-height: 76px;
    --shadow: 0 12px 40px rgba(22, 25, 45, 0.07);
}

* {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    margin: 0;
    color: var(--text);
    background: var(--bg);
    font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

button,
input,
textarea,
select {
    font: inherit;
}

button {
    cursor: pointer;
}

[hidden] {
    display: none !important;
}

body.modal-open {
    overflow: hidden;
}

.container {
    width: min(1440px, calc(100% - 40px));
    margin-inline: auto;
}

.header {
    position: fixed;
    z-index: 50;
    top: 0;
    left: 0;
    width: 100%;
    height: var(--header-height);
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
    background: rgba(255, 255, 255, 0.88);
    backdrop-filter: blur(20px);
}

.header__inner {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
}

.logo {
    color: var(--text);
    text-decoration: none;
    font-weight: 900;
    font-size: 22px;
    letter-spacing: -0.6px;
}

.header__actions {
    display: flex;
    gap: 10px;
}

.main {
